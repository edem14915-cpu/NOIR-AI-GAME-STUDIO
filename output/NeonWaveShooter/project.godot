[gd_project]
config_version=4
run/main_scene="res://scenes/Main.tscn"
application/config/name="Neon Wave: Night Assault"
application/config/icon="res://icon.png"
rendering/renderer/rendering_method="mobile"
rendering/renderer/vsync_mode=0
rendering/renderer/target_fps=90
rendering/renderer/keep_screen_on=true
window/size/width=1280
window/size/height=720
window/size/keep_width=true
window/size/keep_height=true
window/size/stretch_mode="2d"
window/size/stretch_aspect="keep"
window/handheld/orientation="landscape"
autoloads/0/name="GameManager"
autoloads/0/path="res://scripts/game_manager.gd"
autoloads/0/enable=true

[application]
run/max_fps=90
config/icon="res://icon.png"
config/name="Neon Wave: Night Assault"

[display]
window/frame_pacing/android/enable_frame_pacing=true
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
